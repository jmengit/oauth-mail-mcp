# Copy to .env (never commit). Values are supplied by Arcane in production.

# gmail | m365 — decides the provider endpoints, OAuth grant and folder aliases.
MAIL_ACCOUNT=gmail

# The mailbox address. Never committed; injected at deploy time.
MAIL_ADDRESS=

# Bearer token the MCP client must present. Generate with: openssl rand -hex 32
MAIL_MCP_TOKEN=

# Mozilla's public Thunderbird client secret (public-client value, still injected here so the
# image carries nothing account-specific). Required for MAIL_ACCOUNT=gmail.
GOOGLE_CLIENT_SECRET=

# Read-only by default: flags, drafts and sending all refuse unless this is false.
MAIL_READ_ONLY=true

# Leave "false" unless the agent is explicitly allowed to send mail.
MAIL_ALLOW_SEND=false

# Health probe cache, in seconds. Keeps Uptime Kuma polling from hitting the provider.
MAIL_HEALTH_CACHE_SECS=60
